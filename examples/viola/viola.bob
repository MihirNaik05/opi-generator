    </font>
    <height>30</height>
    <horizontal_alignment>1</horizontal_alignment>
    <name>TextUpdate_1</name>
    <pv_name>FS_F1S1:CAM_D1000:cam1:DetectorState_RBV</pv_name>
    <rules>
      <rule prop_id="background_color" name="change background color" out_exp="false">
        <pv_name>FS_F1S1:CAM_D1000:cam1:DetectorState_RBV</pv_name>
        <exp bool_exp="pv0 == 1">
          <value>
            <color red="0" green="255" blue="0" name="Green"/>
          </value>
        </exp>
        <exp bool_exp="pv0 == 0">
          <value>
            <color red="255" green="0" blue="0" name="Red"/>
          </value>
        </exp>
        <exp bool_exp="true">
          <value>
            <color red="127" green="140" blue="141" name="Asbestos"/>
          </value>
        </exp>
      </rule>
    </rules>
    <transparent>false</transparent>
    <vertical_alignment>1</vertical_alignment>
    <width>60</width>
    <x>355.0</x>
    <y>135</y>
  </widget>
