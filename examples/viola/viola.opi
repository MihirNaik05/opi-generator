  <widget typeId="org.csstudio.opibuilder.widgets.ActionButton" version="1.0.0">
    <actions hook="true" hook_all="false">
      <action type="OPEN_DISPLAY">
        <path>https://controls.ftc/opi/diag/AD/ViewerThermal.opi</path>
        <mode>1</mode>
        <description>Open CAM/VD engineering page for FS_F1S1:CAM_D1000</description>
        <macros>
          <include_parent_macros>true</include_parent_macros>
          <NAME>$(DEV) $(INST)</NAME>
          <P>$(SYS)_$(SUB):$(DEV)_$(INST):</P>
          <DEFAULT_PATH>/srv/data/cam/fs-f1s1-cam-d1000</DEFAULT_PATH>
          <SYS>FS</SYS>
          <SUBP>F1S1</SUBP>
          <DEV>CAM</DEV>
          <INST>D1000</INST>
          <SUB>F1S1</SUB>
          <DEVL>LGT</DEVL>
          <MJPGPORT>11000</MJPGPORT>
          <INSTP>D1000</INSTP>
          <MJPGURL>diag-cam-target</MJPGURL>
        </macros>
      </action>
    </actions>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <height>30</height>
