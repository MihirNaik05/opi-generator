  <widget typeId="org.csstudio.opibuilder.widgets.ActionButton" version="1.0.0">
    <actions hook="true" hook_all="false">
      <action type="EXECUTE_CMD">
        <command>/usr/bin/start_viola.sh --set-dir /files/shared/ap/HLA/viola-config --setting /files/shared/ap/HLA/viola-config/$(name)</command>
        <description>Start Viola</description>
        <command_directory>/files/shared/ap/HLA/viola-config</command_directory>
        <wait_time>10</wait_time>
      </action>
    </actions>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <font>
      <fontdata fontName="Liberation Sans" height="13" style="0" pixels="false">Default</fontdata>
    </font>
    <height>30</height>
    <name>ActionButton_71</name>
    <pv_name></pv_name>
    <rules>
      <rule prop_id="name" name="change name" out_exp="true">
        <pv trig="true">FS_F3S2:VD_D1856:CONF</pv>
        <exp bool_exp="true">
          <value>pvStr0</value>
        </exp>
      </rule>
    </rules>
    <text>Open</text>
    <tooltip>Open Viola with defined configuration.</tooltip>
    <version>3.0.0</version>
    <width>100</width>
    <x>1303</x>
    <y>455</y>
  </widget>
