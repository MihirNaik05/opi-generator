<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <background_color>
    <color red="255" green="255" blue="255" name="DISPLAY_BG"/>
  </background_color>
  <grid_visible>true</grid_visible>
  <height>600</height>
  <name>Table Widget</name>
  <width>800</width>
  <x>0</x>
  <y>0</y>
  <widget type="table" version="2.0.0">
    <columns>
      <column>
        <name>ID</name>
        <width>50</width>
        <editable>false</editable>
      </column>
      <column>
        <name>Name</name>
        <width>250</width>
        <editable>false</editable>
      </column>
      <column>
        <name>Value</name>
        <width>300</width>
        <editable>false</editable>
      </column>
    </columns>
    <height>300</height>
    <name>Table_0</name>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
data = []
for i, pv in enumerate(pvs):
    row = [str(i), pv.getName(), PVUtil.getString(pv)]
    data.append(row)
widget.setValue(data)]]></text>
        <pv_name trigger="true">sim://sine</pv_name>
        <pv_name trigger="true">sim://noise</pv_name>
        <pv_name trigger="true">sim://ramp</pv_name>
      </script>
    </scripts>
    <show_toolbar>false</show_toolbar>
    <width>800</width>
    <x>20</x>
    <y>20</y>
  </widget>
</display>
